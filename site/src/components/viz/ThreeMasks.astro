---
/**
 * Level N7, section 5: the three masks of one example, side by side (True = blocked, as in level 15).
 * Source "15" padded to 3 digits; decoder input <bos> fifteen PAD PAD (a batch whose longest input is 4 tokens).
 * Not the "42" example of the exercises, so the figure does not give their answers away.
 * Rows are the tokens Q comes from, columns the tokens K comes from. Two kinds of blocked cell look different:
 * "future" (the causal mask) is a solid fill, "PAD" is the microscope's hatch. A cell blocked by both is shown as future.
 */
const src = ['1', '5', 'PAD']
const tgt = ['<bos>', 'fifteen', 'PAD', 'PAD']
const pad = (t: string) => t === 'PAD'
const grids = [
  { name: 'encoder self-attention', rows: src, cols: src, causal: false, q: 'the digits', k: 'the digits' },
  { name: 'decoder self-attention', rows: tgt, cols: tgt, causal: true, q: 'the decoder input', k: 'the decoder input' },
  { name: 'cross-attention', rows: tgt, cols: src, causal: false, q: 'the decoder input', k: 'memory (the digits)' },
].map((g) => {
  // '' = open, 'f' = blocked as a future word, 'p' = blocked as a PAD column
  const cells = g.rows.map((_, i) => g.cols.map((c, j) => (g.causal && j > i ? 'f' : pad(c) ? 'p' : '')))
  const flat = cells.flat()
  const fut = flat.filter((c) => c === 'f').length
  const pads = flat.filter((c) => c === 'p').length
  const shape = `(${g.rows.length}, ${g.cols.length}), ${fut + pads} blocked${fut ? `: ${fut} future, ${pads} PAD` : ''}`
  const aria = `${g.name} mask, ${g.rows.length} rows by ${g.cols.length} columns: ${fut + pads} cells blocked${fut ? `, ${fut} as future words and ${pads} as PAD` : ', all as PAD'}`
  return { ...g, cells, shape, aria }
})
---
<figure class="tm">
  <div class="grids">
    {grids.map((g) => (
      <div class="one">
        <div class="name">{g.name}</div>
        <div class="shape">{g.shape}</div>
        <table aria-label={g.aria}>
          <thead><tr><th></th>{g.cols.map((c) => <th scope="col" class:list={[c.length > 3 && 'v']}>{c}</th>)}</tr></thead>
          <tbody>
            {g.cells.map((row, i) => (
              <tr><th scope="row">{g.rows[i]}</th>{row.map((c) => <td class:list={[c && 'b', c]}><span>{c ? 1 : 0}</span></td>)}</tr>
            ))}
          </tbody>
        </table>
        <div class="qk">rows (Q): {g.q}<br />columns (K): {g.k}</div>
      </div>
    ))}
  </div>
  <div class="legend">
    <span class="key"><i class="f"></i>blocked: future</span>
    <span class="key"><i class="p"></i>blocked: PAD</span>
    <span class="key">1 means True: blocked. A blocked score becomes −∞, so its weight is 0.</span>
  </div>
  <figcaption>Reading 15 aloud: the source “15” is padded to 3 digits, and the decoder input is
    <code>&lt;bos&gt; fifteen PAD PAD</code>. A cell that is both future and PAD is shown as future.</figcaption>
</figure>

<style>
  .tm { margin: 1.2rem 0; }
  .grids { display: flex; flex-wrap: wrap; gap: 1.2rem 1.6rem; align-items: flex-start; }
  .one { min-width: 0; }
  .name { font-weight: 600; font-size: 0.9rem; }
  .shape, .qk { font-size: 0.78rem; color: var(--dim); font-family: var(--mono); }
  .shape { margin-bottom: 0.3rem; }
  .qk { margin-top: 0.35rem; line-height: 1.4; }
  table { border-collapse: collapse; font-family: var(--mono); font-size: 0.8rem; width: auto; margin: 0; font-variant-numeric: tabular-nums; }
  /* every column the same width, so the cells are square whatever the header says */
  td, thead th { width: 1.8rem; min-width: 1.8rem; max-width: 1.8rem; box-sizing: border-box; }
  td { border: 1px solid var(--line); height: 1.8rem; padding: 0; text-align: center; color: var(--dim); }
  td span { display: inline-block; min-width: 0.9rem; line-height: 1.15; }
  td.b { color: var(--fg); font-weight: 700; }
  /* blocked by the causal mask (a future word): a solid fill */
  td.f, .key i.f { background: color-mix(in srgb, var(--dim) 32%, var(--bg)); }
  /* blocked as a PAD column: the microscope's hatch, dark enough to see in light mode */
  td.p, .key i.p { background: repeating-linear-gradient(135deg, var(--bg) 0 4px, color-mix(in srgb, var(--fg) 45%, var(--bg)) 4px 5.5px); }
  /* the digit sits on a small plain patch, so the hatch never crosses the "1" */
  td.p span { background: var(--bg); border-radius: 2px; padding: 0 0.1rem; }
  th { font-weight: 400; font-size: 0.72rem; color: var(--dim); border: none; padding: 0 0.3rem; white-space: nowrap; }
  thead th { padding: 0 0.1rem 0.15rem; text-align: center; vertical-align: bottom; }
  /* a header longer than the cell ("fifteen", "<bos>") is written upward, so it does not widen its column */
  thead th.v { writing-mode: vertical-rl; transform: rotate(180deg); text-align: left; padding: 0.15rem 0; height: 3.6rem; }
  tbody th { text-align: right; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; color: var(--dim); font-size: 0.85rem; margin-top: 0.7rem; }
  figcaption { color: var(--dim); font-size: 0.85rem; margin-top: 0.35rem; }
  .key { display: inline-flex; align-items: center; gap: 0.4rem; }
  .key i { width: 0.9rem; height: 0.9rem; border: 1px solid var(--line); flex: none; }
</style>
