---
import { langOf, tr } from '@lib/i18n'
const lang = langOf(Astro.url.pathname)
const t = (s: string) => tr(lang, s, undefined, {
  batch: '批', words: '词', scores: '分数', result: '结果',
  'mask (2, 1, 4) → (2, 4, 4)': '掩码 (2, 1, 4) → (2, 4, 4)',
  'the one mask row each sentence stores': '每一句只存的那一行掩码',
  'copies broadcasting reads instead of storing': '广播读出来的副本，并没有存',
  'the first sentence': '第一句',
  'One stored mask row, read four times': '存一行掩码，读四次',
  'The mask keeps one row per sentence. Broadcasting reuses it for every row of the scores.': '掩码每句只存一行。广播把它用到分数的每一行上。',
  'Scores (2, 4, 4) plus a mask stored as (2, 1, 4), stretched to (2, 4, 4)': '分数 (2, 4, 4) 加上存成 (2, 1, 4) 的掩码，拉伸成 (2, 4, 4)',
})
/** Level 1, section 6: a (2,1,4) padding mask broadcast against (2,4,4) attention scores. Faded cells are the stretched copies. */
import TensorsLab from './TensorsLab.svelte'
const one = { from: [0, 0, 0], to: [0, 3, 3], tone: 'accent' }
const tensors = [
  { name: t('scores'), shape: [2, 4, 4], axes: ['batch', 'words', 'words'].map(t), highlight: [one] },
  '+',
  {
    shape: [2, 4, 4], title: t('mask (2, 1, 4) → (2, 4, 4)'), axes: ['batch', 'words', 'words'].map(t),
    highlight: [{ from: [0, 0, 0], to: [0, 0, 3], tone: 'cat-3' }, { from: [1, 0, 0], to: [1, 0, 3], tone: 'cat-3' }],
    ghost: [{ from: [0, 1, 0], to: [1, 3, 3] }],
  },
  '=',
  { name: t('result'), shape: [2, 4, 4], axes: ['batch', 'words', 'words'].map(t), highlight: [one] },
]
const keys = [
  { label: t('the one mask row each sentence stores'), tone: 'cat-3' },
  { label: t('copies broadcasting reads instead of storing'), tone: 'ghost' },
  { label: t('the first sentence'), tone: 'accent' },
]
---
<TensorsLab lang={langOf(Astro.url.pathname)} client:visible title={t('One stored mask row, read four times')} hint={t('The mask keeps one row per sentence. Broadcasting reuses it for every row of the scores.')}
  tensors={tensors} keys={keys} ariaLabel={t('Scores (2, 4, 4) plus a mask stored as (2, 1, 4), stretched to (2, 4, 4)')} />
