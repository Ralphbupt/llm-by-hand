---
import { langOf } from '@lib/i18n'
import Lab from './ArchLab.svelte'
interface Props {
  which: 'backprop' | 'mlp' | 'conv' | 'rnn' | 'seq2seq' | 'autoencoder' | 'encdec' | 'full'
  hide?: { params?: string[] }
}
const { which, hide } = Astro.props
---
<Lab lang={langOf(Astro.url.pathname)} client:visible which={which} hide={hide} />
