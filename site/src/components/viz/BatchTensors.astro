---
import { langOf, tr } from '@lib/i18n'
const lang = langOf(Astro.url.pathname)
const t = (s: string) => tr(lang, s, undefined, {
  batch: '批', words: '词', features: '特征', in: '输入', out: '输出',
  'one word of the first sentence: 4 numbers in, 8 out': '第一句的一个词：进来 4 个数，出去 8 个',
  'W: the same for every word of every sentence': 'W：每一句的每一个词都用同一个',
  'A batch through one weight matrix': '一批数据经过同一个权重矩阵',
  'Only the last axis changes: 4 numbers per word become 8. In 3D, drag to turn the blocks.': '只有最后一个轴变了：每个词的 4 个数变成 8 个。在 3D 视图里拖动可以转动这些方块。',
  'X with shape (2, 5, 4) times W with shape (4, 8) gives Y with shape (2, 5, 8)': '形状 (2, 5, 4) 的 X 乘以形状 (4, 8) 的 W，得到形状 (2, 5, 8) 的 Y',
})
/** Level 1, section 4: the batch multiply X (2,5,4) @ W (4,8) = Y (2,5,8) in 3D. One word's row and its result row are highlighted. */
import TensorsLab from './TensorsLab.svelte'
const tensors = [
  { name: 'X', shape: [2, 5, 4], axes: ['batch', 'words', 'features'].map(t), highlight: [{ from: [0, 0, 0], to: [0, 0, 3], tone: 'accent' }] },
  '@',
  { name: 'W', shape: [4, 8], axes: ['in', 'out'].map(t), highlight: [{ from: [0, 0, 0], to: [0, 3, 7], tone: 'cat-2' }] },
  '=',
  { name: 'Y', shape: [2, 5, 8], axes: ['batch', 'words', 'features'].map(t), highlight: [{ from: [0, 0, 0], to: [0, 0, 7], tone: 'accent' }] },
]
const keys = [
  { label: t('one word of the first sentence: 4 numbers in, 8 out'), tone: 'accent' },
  { label: t('W: the same for every word of every sentence'), tone: 'cat-2' },
]
---
<TensorsLab lang={langOf(Astro.url.pathname)} client:visible title={t('A batch through one weight matrix')} hint={t('Only the last axis changes: 4 numbers per word become 8. In 3D, drag to turn the blocks.')}
  tensors={tensors} keys={keys} ariaLabel={t('X with shape (2, 5, 4) times W with shape (4, 8) gives Y with shape (2, 5, 8)')} />
