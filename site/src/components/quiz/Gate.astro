---
/**
 * One part of a lesson, tied to the question above it. Every part is open from the start: questions earn stars,
 * they never block reading. `requires` names that question (scripts/check_exercises.py checks that it exists).
 */
interface Props { requires: string }
const { requires } = Astro.props
---
<div class="gate" data-gate={requires}>
  <div class="content"><slot /></div>
</div>

<style>
  .gate { margin: 1.2rem 0; }
</style>
